# LLM providers
GROQ_API_KEY=gsk_xxxxx
# Optional comma-separated rotation keys for resilience during development.
GROQ_API_KEYS=gsk_xxxxx,gsk_yyyyy
GOOGLE_API_KEY=xxxxx
GOOGLE_API_KEYS=xxxxx,yyyyy
OPENROUTER_API_KEY=sk-or-v1-xxxxx  # optional

# Tools
TAVILY_API_KEY=tvly-xxxxx
TAVILY_API_KEYS=tvly-xxxxx,tvly-yyyyy

# Observability
LANGSMITH_API_KEY=lsv2_xxxxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=deep-research-agent

# Local services
# Native local runs: http://localhost:11434
# Docker Compose ignores OLLAMA_HOST and uses DOCKER_OLLAMA_HOST below.# LLM providers
GROQ_API_KEY=gsk_xxxxx
# Optional comma-separated rotation keys for resilience during development.
GROQ_API_KEYS=gsk_xxxxx,gsk_yyyyy
GOOGLE_API_KEY=xxxxx
GOOGLE_API_KEYS=xxxxx,yyyyy
OPENROUTER_API_KEY=sk-or-v1-xxxxx  # optional

# Tools
TAVILY_API_KEY=tvly-xxxxx
TAVILY_API_KEYS=tvly-xxxxx,tvly-yyyyy

# Observability
LANGSMITH_API_KEY=lsv2_xxxxx
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=deep-research-agent

# Local services
# Native local runs: http://localhost:11434
# Docker Compose ignores OLLAMA_HOST and uses DOCKER_OLLAMA_HOST below.
OLLAMA_HOST=http://localhost:11434
DOCKER_OLLAMA_HOST=http://host.docker.internal:11434
QDRANT_URL=http://localhost:6333

# App config
APP_MODE=development
MAX_RESEARCH_ITERATIONS=3
MAX_PARALLEL_RESEARCHERS=1
MAX_SUBTASKS=5
MAX_GAP_ROUNDS=1
MAX_SOURCES_PER_TASK=4
MAX_DIRECT_FETCHES_PER_TASK=2
SOURCE_BROKER_SEARCH_RESULTS=8
SEARCH_PROVIDER_ORDER=tavily,ddg
GROQ_SYNTHESIZER_MAX_TOKENS=3000
GROQ_SYNTHESIZER_FALLBACK_MAX_TOKENS=2200

# Quality-first model routing for ~10 reports/week.
GROQ_PLANNER_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_RESEARCHER_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile
GROQ_EXTRACTOR_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_SYNTHESIZER_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
GOOGLE_CRITIC_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

